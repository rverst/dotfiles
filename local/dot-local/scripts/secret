#!/usr/bin/env bash
#
# secret - read/write secrets from the OS keyring, and hand them to a single
# command instead of exporting them into every shell.
#
# The point: a secret should never sit in cleartext on disk, and never be
# exported into the environment of every process you launch. `secret run`
# injects a value into exactly one child process; `secret get` is a reference
# you can use from .envrc, Makefiles or a build script.
#
# Backends (auto-detected, in order; override with SECRET_BACKEND):
#   macOS  security(1)     - login keychain, unlocked at login, no prompt
#   Linux  secret-tool(1)  - libsecret / Secret Service (gnome-keyring, KWallet)
#   WSL2   pwsh.exe        - PowerShell 7 + SecretManagement/SecretStore on the
#                            Windows side, reached over WSL interop. PowerShell
#                            5.1 is not supported (UTF-16LE/CRLF pain).
#
# The WSL bridge keeps values off argv: the *script* travels in -EncodedCommand,
# the verb/name travel in env vars (forwarded via WSLENV), and the *value* only
# ever crosses on stdin/stdout, base64-encoded in both directions. That also
# sidesteps every encoding and quoting problem at the boundary.
#
# Optional: `secret sync` pulls values from a password vault, so the vault stays
# the system of record and the keyring is just a fast local cache. Two vault
# backends (auto-detected, override with SECRET_VAULT):
#   rbw        rbw(1)           - Bitwarden / Vaultwarden; rbw-agent caches the unlock
#   keepassxc  keepassxc-cli(1) - a local .kdbx; needs SECRET_KEEPASS_DB
#
# Vault layout convention, identical for both: one item per secret, inside a
# folder/group (SECRET_VAULT_FOLDER, default "dotfiles"), with the item name
# equal to the secret name and the value in the password field. That is what
# makes `sync --all` possible.
#
# Usage:
#   secret set <name>                 store a value (hidden prompt)
#   secret get <name>                 print a value to stdout
#   secret rm <name>                  delete a value
#   secret list                       list stored names
#   secret run <NAME>... -- <cmd>...  run cmd with NAME exported, nothing else
#   secret sync <name> [item]         pull one value from the vault
#   secret sync --all                 pull every item in the vault folder
#   secret sync --list                list vault item names (no values)
#
# Environment:
#   SECRET_BACKEND        keyring backend: macos | libsecret | wsl
#   SECRET_PREFIX         keyring namespace (default: dotfiles)
#   SECRET_VAULT          vault backend: rbw | keepassxc
#   SECRET_VAULT_FOLDER   vault folder/group (default: dotfiles)
#   SECRET_VAULT_FIELD    field to read (default: the password field)
#   SECRET_KEEPASS_DB     path to the .kdbx database
#   SECRET_KEEPASS_KEYFILE  optional key file
#   SECRET_KEEPASS_YUBIKEY  optional YubiKey slot, e.g. 1 or 1:7370001
#   SECRET_KEEPASS_NO_PASSWORD  set to 1 for a key-file/YubiKey-only database

set -o errexit
set -o nounset
set -o pipefail

PROG="${0##*/}"

# Keyring namespace. Everything this script owns is prefixed, so `list` and
# `rm` can never touch unrelated keychain entries.
PREFIX="${SECRET_PREFIX:-dotfiles}"

# Field separator for the batched `getmany` response.
TAB="$(printf '\t')"

die() {
	printf '%s: %s\n' "${PROG}" "$*" >&2
	exit 1
}

usage() {
	sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

# Locate PowerShell 7 on the Windows side. `command -v` first, because some
# people set appendWindowsPath=false in /etc/wsl.conf; then the default install
# location. Deliberately never falls back to powershell.exe (5.1).
_find_pwsh() {
	if command -v pwsh.exe >/dev/null 2>&1; then
		command -v pwsh.exe
		return 0
	fi
	if [ -x "/mnt/c/Program Files/PowerShell/7/pwsh.exe" ]; then
		printf '%s' "/mnt/c/Program Files/PowerShell/7/pwsh.exe"
		return 0
	fi
	return 1
}

# Resolve the keyring backend once. Detection is by command availability rather
# than by uname, so a stubbed `security` on PATH works in the test sandbox.
backend() {
	if [ -n "${SECRET_BACKEND:-}" ]; then
		printf '%s' "${SECRET_BACKEND}"
		return 0
	fi

	if command -v security >/dev/null 2>&1; then
		printf 'macos'
	elif command -v secret-tool >/dev/null 2>&1; then
		printf 'libsecret'
	elif _find_pwsh >/dev/null 2>&1; then
		printf 'wsl'
	elif command -v powershell.exe >/dev/null 2>&1; then
		# Windows PowerShell 5.1 only. Refuse rather than degrade.
		die "found powershell.exe but not pwsh.exe; PowerShell 7 is required (winget install Microsoft.PowerShell)"
	else
		die "no keyring backend available (need security(1) on macOS, secret-tool(1) from libsecret on Linux, or pwsh.exe on WSL2)"
	fi
}

# Validate a secret name early: it becomes part of a keychain service string,
# and a typo'd/empty name would otherwise silently create a junk entry.
check_name() {
	local name="${1:-}"
	[ -n "${name}" ] || die "missing secret name"
	case "${name}" in
	*[!A-Za-z0-9_.-]*) die "invalid secret name '${name}' (allowed: A-Z a-z 0-9 _ . -)" ;;
	esac
}

# --- WSL2 <-> Windows bridge ------------------------------------------------

# BSD base64 spells decode -D, GNU spells it -d. Probe rather than assume,
# since the test stub exercises this path on macOS too.
_b64_decode_flag() {
	if printf 'eA==' | base64 -d >/dev/null 2>&1; then
		printf -- '-d'
	else
		printf -- '-D'
	fi
}

_b64_encode() { base64 | tr -d '\n'; }
_b64_decode() { base64 "$(_b64_decode_flag)"; }

# The PowerShell side, as one script that dispatches on $env:SECRET_PS_VERB.
# Nothing here is interpolated from bash: name, prefix and vault all arrive as
# environment variables, so there is no quoting or injection surface at all.
#
# Exit codes: 8 = SecretManagement missing, 9 = vault unusable (usually locked).
_ps_script() {
	cat <<-'PS'
		$ErrorActionPreference = 'Stop'
		if (-not (Get-Module -ListAvailable Microsoft.PowerShell.SecretManagement)) { exit 8 }
		Import-Module Microsoft.PowerShell.SecretManagement -ErrorAction SilentlyContinue

		$prefix = $env:SECRET_PS_PREFIX
		$p = @{}
		if ($env:SECRET_PS_VAULT) { $p['Vault'] = $env:SECRET_PS_VAULT }

		function Enc([string] $s) { [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($s)) }
		function Full([string] $n) { $prefix + ':' + $n }
		function Read1([string] $n) { Get-Secret -Name (Full $n) @p -AsPlainText -ErrorAction SilentlyContinue }

		try {
		    switch ($env:SECRET_PS_VERB) {
		        'get' {
		            $v = Read1 $env:SECRET_PS_NAME
		            if ($null -ne $v) { [Console]::Out.Write((Enc $v)) }
		        }
		        'getmany' {
		            foreach ($n in ($env:SECRET_PS_NAMES -split ',')) {
		                if (-not $n) { continue }
		                $v = Read1 $n
		                $e = if ($null -ne $v) { Enc $v } else { '' }
		                [Console]::Out.Write($n + "`t" + $e + "`n")
		            }
		        }
		        'set' {
		            $b = [Console]::In.ReadToEnd().Trim()
		            $v = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b))
		            Set-Secret -Name (Full $env:SECRET_PS_NAME) -Secret $v @p
		        }
		        'rm' {
		            Remove-Secret -Name (Full $env:SECRET_PS_NAME) @p
		        }
		        'list' {
		            Get-SecretInfo @p |
		                Where-Object { $_.Name -like ($prefix + ':*') } |
		                ForEach-Object { [Console]::Out.Write($_.Name.Substring($prefix.Length + 1) + "`n") }
		        }
		        default { exit 1 }
		    }
		} catch {
		    [Console]::Error.Write($_.Exception.Message)
		    exit 9
		}
	PS
}

# Invoke the Windows side. stdin/stdout pass straight through, so the caller
# decides whether a value crosses the boundary.
_ps_run() {
	local verb="$1" name="${2:-}" names="${3:-}"
	local pwsh encoded status

	pwsh="$(_find_pwsh)" || die "pwsh.exe not found (winget install Microsoft.PowerShell)"

	# -EncodedCommand wants base64 of UTF-16LE. The script is not secret; the
	# encoding exists purely to avoid shell/PowerShell quoting collisions.
	encoded="$(_ps_script | iconv -f UTF-8 -t UTF-16LE | _b64_encode)"

	# WSL does not forward environment variables to Windows processes unless
	# they are listed in WSLENV. Without it the child would see none of them.
	set +o errexit
	SECRET_PS_VERB="${verb}" \
		SECRET_PS_NAME="${name}" \
		SECRET_PS_NAMES="${names}" \
		SECRET_PS_PREFIX="${PREFIX}" \
		SECRET_PS_VAULT="${SECRET_PS_VAULT:-}" \
		WSLENV="SECRET_PS_VERB:SECRET_PS_NAME:SECRET_PS_NAMES:SECRET_PS_PREFIX:SECRET_PS_VAULT${WSLENV:+:${WSLENV}}" \
		"${pwsh}" -NoProfile -NonInteractive -EncodedCommand "${encoded}" | tr -d '\r'
	status="${PIPESTATUS[0]}"
	set -o errexit

	return "${status}"
}

# Turn the bridge's exit codes into advice instead of a bare failure.
_ps_fail() {
	case "$1" in
	8) die "PowerShell SecretManagement is not installed on the Windows side. Run in pwsh: Install-Module Microsoft.PowerShell.SecretManagement, Microsoft.PowerShell.SecretStore" ;;
	9) die "the Windows secret vault could not be opened - it is probably locked. Run in pwsh: Set-SecretStoreConfiguration -Authentication None -Interaction None" ;;
	*) die "pwsh.exe failed (exit $1)" ;;
	esac
}

# --- keyring operations -----------------------------------------------------

secret_get() {
	local name="$1" value encoded
	check_name "${name}"

	case "$(backend)" in
	macos) value="$(security find-generic-password -s "${PREFIX}:${name}" -a "${USER}" -w 2>/dev/null)" || value="" ;;
	libsecret) value="$(secret-tool lookup "${PREFIX}" "${name}" 2>/dev/null)" || value="" ;;
	wsl)
		encoded="$(_ps_run get "${name}" </dev/null)" || _ps_fail "$?"
		if [ -n "${encoded}" ]; then
			value="$(printf '%s' "${encoded}" | _b64_decode)"
		else
			value=""
		fi
		;;
	esac

	# Fail loudly. Printing nothing and exiting 0 would let a caller export an
	# empty token and get a confusing 401 from the far end instead.
	[ -n "${value}" ] || die "no secret '${name}' in the keyring (run: ${PROG} set ${name})"

	printf '%s\n' "${value}"
}

secret_store() {
	local name="$1" value="$2"

	case "$(backend)" in
	macos)
		# -U updates an existing item instead of erroring on a duplicate.
		# The value goes through argv here: security(1) has no stdin input mode,
		# and its own -w prompt reads the tty directly (which would break
		# non-interactive use). Exposure is a single execve on a single-user
		# machine; the alternative is worse.
		security add-generic-password -U -s "${PREFIX}:${name}" -a "${USER}" -w "${value}"
		;;
	libsecret)
		printf '%s' "${value}" |
			secret-tool store --label="${PREFIX}: ${name}" "${PREFIX}" "${name}"
		;;
	wsl)
		# The value crosses on stdin only: never in argv, so it stays out of
		# the Windows process list.
		printf '%s' "${value}" | _b64_encode | _ps_run set "${name}" >/dev/null || _ps_fail "$?"
		;;
	esac
}

secret_set() {
	local name="$1" value
	check_name "${name}"

	# Read from a hidden prompt rather than an argument, so the value never
	# lands in ~/.zsh_history or in `ps` output.
	if [ -t 0 ]; then
		printf 'Value for %s: ' "${name}" >&2
		read -r -s value
		printf '\n' >&2
	else
		read -r value
	fi

	[ -n "${value}" ] || die "empty value, nothing stored"

	secret_store "${name}" "${value}"
	printf 'stored %s\n' "${name}" >&2
}

secret_rm() {
	local name="$1"
	check_name "${name}"

	case "$(backend)" in
	macos) security delete-generic-password -s "${PREFIX}:${name}" -a "${USER}" >/dev/null ;;
	libsecret) secret-tool clear "${PREFIX}" "${name}" ;;
	wsl) _ps_run rm "${name}" </dev/null >/dev/null || _ps_fail "$?" ;;
	esac

	printf 'removed %s\n' "${name}" >&2
}

secret_list() {
	local out
	case "$(backend)" in
	macos)
		# Metadata-only dump: no unlock prompt, no values.
		security dump-keychain 2>/dev/null |
			sed -n 's/.*"svce"<blob>="'"${PREFIX}"':\(.*\)"$/\1/p' |
			sort -u
		;;
	libsecret)
		secret-tool search --all "${PREFIX}" '*' 2>/dev/null |
			sed -n 's/^attribute\.'"${PREFIX}"' = //p' |
			sort -u
		;;
	wsl)
		# Names only: Get-SecretInfo never touches the values.
		out="$(_ps_run list "" "" </dev/null)" || _ps_fail "$?"
		if [ -n "${out}" ]; then
			printf '%s\n' "${out}" | sort -u
		fi
		;;
	esac
}

# Run a command with the named secrets exported into that process only.
secret_run() {
	local -a names=() env_args=()
	local name batch bname bval

	while [ $# -gt 0 ]; do
		[ "$1" = "--" ] && break
		names+=("$1")
		shift
	done

	[ "${1:-}" = "--" ] || die "missing -- separator (usage: ${PROG} run NAME... -- cmd...)"
	shift

	[ ${#names[@]} -gt 0 ] || die "no secret names given"
	[ $# -gt 0 ] || die "no command given"

	# Resolve everything up front: if one lookup fails we abort without having
	# run the command, rather than running it half-configured.
	for name in "${names[@]}"; do
		check_name "${name}"
	done

	if [ "$(backend)" = "wsl" ]; then
		# One interop call instead of N. Each pwsh.exe round trip costs a few
		# hundred ms, which is very noticeable for `run A B C`.
		batch="$(_ps_run getmany "" "$(
			IFS=,
			printf '%s' "${names[*]}"
		)" </dev/null)" || _ps_fail "$?"

		while IFS="${TAB}" read -r bname bval; do
			[ -n "${bname}" ] || continue
			[ -n "${bval}" ] ||
				die "no secret '${bname}' in the keyring (run: ${PROG} set ${bname})"
			env_args+=("${bname}=$(printf '%s' "${bval}" | _b64_decode)")
		done <<<"${batch}"

		[ ${#env_args[@]} -eq ${#names[@]} ] ||
			die "the keyring returned ${#env_args[@]} of ${#names[@]} secrets"
	else
		for name in "${names[@]}"; do
			env_args+=("${name}=$(secret_get "${name}")")
		done
	fi

	exec env "${env_args[@]}" "$@"
}

# --- vault (source of truth) ------------------------------------------------

# Which vault CLI to talk to. Same detection philosophy as backend(): by
# command availability, so the test sandbox can stub either one.
vault_backend() {
	if [ -n "${SECRET_VAULT:-}" ]; then
		case "${SECRET_VAULT}" in
		rbw | keepassxc) printf '%s' "${SECRET_VAULT}" ;;
		*) die "unknown SECRET_VAULT '${SECRET_VAULT}' (expected: rbw, keepassxc)" ;;
		esac
		return 0
	fi

	# An explicitly configured database wins: if you point at a .kdbx you mean it,
	# even on a machine that also happens to have rbw installed.
	if [ -n "${SECRET_KEEPASS_DB:-}" ] && command -v keepassxc-cli >/dev/null 2>&1; then
		printf 'keepassxc'
	elif command -v rbw >/dev/null 2>&1; then
		printf 'rbw'
	elif command -v keepassxc-cli >/dev/null 2>&1; then
		printf 'keepassxc'
	else
		die "no vault backend available for '${PROG} sync' (install rbw for Bitwarden/Vaultwarden, or keepassxc-cli plus SECRET_KEEPASS_DB for a local .kdbx)"
	fi
}

vault_folder() { printf '%s' "${SECRET_VAULT_FOLDER:-dotfiles}"; }

# --- rbw --------------------------------------------------------------------

_rbw_unlock() {
	rbw unlocked >/dev/null 2>&1 || rbw unlock || die "could not unlock the vault"
}

_rbw_get() {
	local item="$1"
	local -a args=(get --folder "$(vault_folder)" "${item}")
	[ -n "${SECRET_VAULT_FIELD:-}" ] && args+=(--field "${SECRET_VAULT_FIELD}")
	rbw "${args[@]}"
}

# Names of every item in the folder. `--fields folder,name` is tab separated,
# and an item outside any folder reports an empty folder column.
_rbw_list() {
	local folder itemfolder name
	folder="$(vault_folder)"
	rbw list --fields folder,name |
		while IFS="${TAB}" read -r itemfolder name; do
			[ "${itemfolder}" = "${folder}" ] || continue
			[ -n "${name}" ] || continue
			printf '%s\n' "${name}"
		done
}

# --- keepassxc --------------------------------------------------------------

# The database passphrase, read once per process and reused. keepassxc-cli has
# no agent, so every call re-derives the KDF - but it only asks once.
KP_PASS=""
KP_PASS_READ=0

_kp_db() {
	[ -n "${SECRET_KEEPASS_DB:-}" ] ||
		die "SECRET_KEEPASS_DB is not set (point it at your .kdbx, e.g. in ~/.localrc)"
	[ -f "${SECRET_KEEPASS_DB}" ] ||
		die "keepass database '${SECRET_KEEPASS_DB}' does not exist"
	printf '%s' "${SECRET_KEEPASS_DB}"
}

_kp_no_password() {
	[ "${SECRET_KEEPASS_NO_PASSWORD:-0}" = "1" ]
}

# Common flags for every keepassxc-cli invocation. -q keeps the prompt and other
# chatter off stdout, so a value comes back clean.
_kp_args() {
	printf '%s\n' -q
	[ -n "${SECRET_KEEPASS_KEYFILE:-}" ] && printf '%s\n%s\n' -k "${SECRET_KEEPASS_KEYFILE}"
	[ -n "${SECRET_KEEPASS_YUBIKEY:-}" ] && printf '%s\n%s\n' -y "${SECRET_KEEPASS_YUBIKEY}"
	_kp_no_password && printf '%s\n' --no-password
	return 0
}

_kp_read_pass() {
	_kp_no_password && return 0
	[ "${KP_PASS_READ}" -eq 1 ] && return 0

	# Same contract as secret_set: hidden prompt on a tty, plain read when the
	# passphrase is piped in (scripts, CI, the test suite).
	if [ -t 0 ]; then
		printf 'Passphrase for %s: ' "${SECRET_KEEPASS_DB##*/}" >&2
		IFS= read -r -s KP_PASS
		printf '\n' >&2
	else
		IFS= read -r KP_PASS || true
	fi

	KP_PASS_READ=1
	return 0
}

# Run keepassxc-cli with the passphrase on stdin - never in argv, so it stays
# out of the process list.
_kp_run() {
	local -a args=()
	local flag
	while IFS= read -r flag; do
		args+=("${flag}")
	done < <(_kp_args)

	_kp_read_pass
	if _kp_no_password; then
		keepassxc-cli "$1" "${args[@]}" "${@:2}" </dev/null
	else
		printf '%s\n' "${KP_PASS}" | keepassxc-cli "$1" "${args[@]}" "${@:2}"
	fi
}

_kp_get() {
	local item="$1" db field
	db="$(_kp_db)"
	field="${SECRET_VAULT_FIELD:-Password}"
	# -s prints protected attributes (i.e. the password) in clear text.
	_kp_run show -s -a "${field}" "${db}" "/$(vault_folder)/${item}"
}

# Leaf entries of the folder. `ls -R -f` flattens to paths relative to the
# group and marks groups with a trailing slash, which is what we filter on.
# Entries in nested groups keep their `sub/` prefix and are therefore rejected
# by check_name later, which is the intent: keep the layout flat.
_kp_list() {
	local db folder line
	db="$(_kp_db)"
	folder="$(vault_folder)"
	_kp_run ls -R -f "${db}" "/${folder}" |
		while IFS= read -r line; do
			case "${line}" in
			"" | */) continue ;;
			esac
			printf '%s\n' "${line}"
		done
}

# --- vault dispatch ---------------------------------------------------------

# Unlock once, in the *parent* shell. vault_get is normally called inside a
# command substitution, and a subshell could neither reuse rbw's agent decision
# nor keep the keepass passphrase around - so every item would re-prompt.
vault_prepare() {
	case "$(vault_backend)" in
	rbw) _rbw_unlock ;;
	keepassxc)
		_kp_db >/dev/null
		_kp_read_pass
		;;
	esac
}

vault_get() {
	case "$(vault_backend)" in
	rbw) _rbw_get "$1" ;;
	keepassxc) _kp_get "$1" ;;
	esac
}

vault_list() {
	case "$(vault_backend)" in
	rbw) _rbw_list ;;
	keepassxc) _kp_list ;;
	esac
}

# Pull one value from the vault into the keyring.
_sync_one() {
	local name="$1" item="$2" value
	value="$(vault_get "${item}")" || die "no vault item '${item}' in folder '$(vault_folder)'"
	[ -n "${value}" ] || die "vault item '${item}' is empty"

	secret_store "${name}" "${value}"
	printf 'synced %s from vault item %s\n' "${name}" "${item}" >&2
}

# Pull every item of the vault folder. Items that can't be a secret name are
# skipped with a warning rather than aborting the run: a shared folder tends to
# collect things this script has no business touching.
_sync_all() {
	local -a items=()
	local item value synced=0 total=0

	while IFS= read -r item; do
		[ -n "${item}" ] || continue
		items+=("${item}")
	done < <(vault_list)

	[ ${#items[@]} -gt 0 ] ||
		die "no items in vault folder '$(vault_folder)' (set SECRET_VAULT_FOLDER to change it)"

	for item in "${items[@]}"; do
		total=$((total + 1))
		case "${item}" in
		*[!A-Za-z0-9_.-]*)
			printf '%s: skipping vault item %s (not a valid secret name)\n' "${PROG}" "${item}" >&2
			continue
			;;
		esac

		value="$(vault_get "${item}")" || value=""
		if [ -z "${value}" ]; then
			printf '%s: skipping vault item %s (empty or unreadable)\n' "${PROG}" "${item}" >&2
			continue
		fi

		secret_store "${item}" "${value}"
		synced=$((synced + 1))
	done

	printf 'synced %d of %d items from vault folder %s\n' "${synced}" "${total}" "$(vault_folder)" >&2
	[ "${synced}" -gt 0 ] || die "nothing synced"
}

secret_sync() {
	case "${1:-}" in
	--all)
		[ $# -eq 1 ] || die "'${PROG} sync --all' takes no further arguments"
		vault_prepare
		_sync_all
		return
		;;
	--list)
		[ $# -eq 1 ] || die "'${PROG} sync --list' takes no further arguments"
		vault_prepare
		vault_list
		return
		;;
	-*) die "unknown option '$1' (try: ${PROG} --help)" ;;
	esac

	local name="${1:-}" item="${2:-}"
	check_name "${name}"
	vault_prepare
	_sync_one "${name}" "${item:-${name}}"
}

main() {
	local cmd="${1:-}"
	[ $# -gt 0 ] && shift

	case "${cmd}" in
	get) secret_get "${1:-}" ;;
	set) secret_set "${1:-}" ;;
	rm | remove | delete) secret_rm "${1:-}" ;;
	list | ls) secret_list ;;
	run | exec) secret_run "$@" ;;
	sync) secret_sync "$@" ;;
	-h | --help | help) usage 0 ;;
	"") usage 1 ;;
	*) die "unknown command '${cmd}' (try: ${PROG} --help)" ;;
	esac
}

main "$@"
