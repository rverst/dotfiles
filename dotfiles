#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

__dir="$(cd "$(dirname "$0")" && pwd)"
__file="${__dir}/$(basename "$0")"
__base="$(basename "${__file}")"
__root="$(cd "$(dirname "${__dir}")" && pwd)"

DOT_DRY=
DOT_SIL=
DOT_UNA=

DOTFILES_BRANCH=main
DOTFILES_DIR="${__dir}"
# Top-level packages (excluding hidden dirs and flavours)
PACKAGES="$(find "${DOTFILES_DIR}" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name 'flavours' -print 2>/dev/null)"

usage() {
	echo "Dotfiles installer"
	echo ""
	echo "Usage:"
	echo ""
	echo "  dotfiles [options] <command> [args]"
	echo ""
	echo "Commands:"
	echo "  install          install the dotfiles"
	echo "  reinstall        reinstall the dotfiles (unlink->link)"
	echo "  uninstall        uninstall the dotfiles (unlink)"
	echo "  update           update the dotfiles (check remote repository)"
	echo "  status           encrypt changes and check git status"
	echo "  flavour [name]   show current flavour or switch to specified flavour"
	echo "  reencrypt-all    re-encrypt all files with current recipients"
	echo ""
	echo "  add <file> [flavour|regular] [package]"
	echo "                 add existing file to dotfiles"
	echo "                 flavour: add to current flavour (encrypted)"
	echo "                 regular: add to regular package (default: home)"
	echo "                 no type: interactive selection"
	echo ""
	echo "Options:"
	echo "  -n      dry run"
	echo "  -s      silent"
	echo "  -u      unattended"
	echo ""
}

cleanup() {
	info "Cleanup"
	exit 0
}

check_dependencies() {
	if ! command -v age >/dev/null 2>&1; then
		error "Age is required but not installed"
		info "Install with: brew install age - or your package manager"
		exit 1
	fi

	if ! command -v stow >/dev/null 2>&1; then
		error "Stow is required but not installed"
		exit 1
	fi

	if ! command -v zsh >/dev/null 2>&1; then
		error "zsh is required (for interactive shell configs) but not installed"
		info "Please run './bootstrap' to install it, or install it via your package manager"
		exit 1
	fi
}

stow_packages() {
	local flags=""
	local current_flavour
	current_flavour=$(flavour_get_current)
	local flavour_stow_dir=""

	if [ -n "${DOT_DRY:-}" ]; then
		flags="${flags}-nv"
	fi

	flavour_stow_dir=$(flavour_prepare_stow "${current_flavour}")

	while IFS= read -r pkg_dir; do
		[ -z "${pkg_dir}" ] && continue
		local pkg
		pkg=$(basename "${pkg_dir}")
		if [ "${pkg}" = "flavours" ]; then
			continue
		fi
		info "  package: ${pkg}"
		stow --dotfiles ${flags} -t "${HOME}" -d "${DOTFILES_DIR}" "$1" "${pkg}"
	done <<<"${PACKAGES}"

	if [ -n "${flavour_stow_dir}" ] && [ -d "${flavour_stow_dir}" ]; then
		info "  package: flavours (${current_flavour})"
		stow --dotfiles ${flags} -t "${HOME}" -d "${DOTFILES_DIR}/flavours" "$1" "decrypted-${current_flavour}"
	fi

	if [ "$1" == "-D" ]; then
		flavour_cleanup_stow "${current_flavour}"
	fi

	success "Done"
}

do_install() {
	check_dependencies
	age_init

	info "Installing dotfiles with flavour: $(flavour_get_current)"
	stow_packages -S

	[ -z "${DOT_UNA:-}" ] && setup_gitconfig
	setup_localrc
}

do_reinstall() {
	check_dependencies
	info "Reinstalling dotfiles with flavour: $(flavour_get_current)"
	stow_packages -R
}

do_uninstall() {
	info "Uninstalling dotfiles"
	stow_packages -D
}

do_update() {
	check_dependencies
	info "Updating dotfiles"

	if ! git -C "${DOTFILES_DIR}" diff --exit-code >/dev/null; then
		warn "Dotfiles repository is dirty. Commit or stash your changes first."
		exit 1
	fi

	stow_packages -D
	git -C "${DOTFILES_DIR}" pull origin "${DOTFILES_BRANCH}"
	git -C "${DOTFILES_DIR}" submodule update --recursive
	stow_packages -S
}

do_status() {
	check_dependencies

	info "Git Status:"
	git -C "${DOTFILES_DIR}" status --short

	info "Current flavour: $(flavour_get_current)"

	flavour_encrypt_changes

	echo ""
	info "Git Status after encryption check:"
	git -C "${DOTFILES_DIR}" status --short
}

do_flavour() {
	local target_flavour="$1"

	if [ -z "${target_flavour}" ]; then
		echo "Current flavour: $(flavour_get_current)"
		echo ""
		echo "Available flavours:"
		flavour_list_available | sed 's/^/  /'
		return
	fi

	if [ ! -d "${DOTFILES_DIR}/flavours/${target_flavour}" ]; then
		error "Flavour '${target_flavour}' does not exist"
		echo "Available flavours:"
		flavour_list_available | sed 's/^/  /'
		exit 1
	fi

	flavour_set_current "${target_flavour}"

	info "Switching to flavour: ${target_flavour}"
	stow_packages -R
}

do_reencrypt_all() {
	check_dependencies
	age_reencrypt_all
}

do_add() {
	local source_file="${1:-}"
	local add_type="${2:-}"
	local package_name="${3:-}"

	if [ -z "${source_file}" ]; then
		error "No file specified"
		usage
		exit 1
	fi

	source_file=$(realpath "${source_file}" 2>/dev/null || echo "${source_file}")

	case "${add_type}" in
	"flavour")
		check_dependencies
		flavour_add_file "${source_file}"
		;;
	"regular" | "package")
		add_regular_file "${source_file}" "${package_name:-home}"
		;;
	"")
		check_dependencies
		add_file_interactive "${source_file}"
		;;
	*)
		error "Invalid add type: ${add_type}"
		usage
		exit 1
		;;
	esac

	if [ -z "${DOT_UNA:-}" ]; then
		echo ""
		local commit_choice
		user_yesno "Commit changes to git?" "y" commit_choice

		if [ "${commit_choice}" -eq 1 ]; then
			git -C "${DOTFILES_DIR}" add .
			git -C "${DOTFILES_DIR}" commit -m "Add $(basename "${source_file}") to ${add_type:-dotfiles}"
			info "Changes committed"
		fi
	fi
}

main() {
	# shellcheck source=/dev/null
	source "$__dir/.scripts/print.sh"
	# shellcheck source=/dev/null
	source "$__dir/.scripts/utils.sh"
	# shellcheck source=/dev/null
	source "$__dir/.scripts/age.sh"
	# shellcheck source=/dev/null
	source "$__dir/.scripts/flavours.sh"
	# shellcheck source=/dev/null
	source "$__dir/.scripts/add.sh"

	OPTIND=1
	OPTERR=0
	while getopts "hnsu" opt; do
		case "$opt" in
		h)
			usage
			exit 0
			;;
		n)
			DOT_DRY=1
			;;
		s)
			DOT_SIL=1
			;;
		u)
			DOT_UNA=1
			;;
		*)
			usage
			exit 1
			;;
		esac
	done
	shift $((OPTIND - 1))
	[ "${1:-}" = "--" ] && shift

	case "${1:-}" in
	install)
		do_install
		;;
	reinstall)
		do_reinstall
		;;
	uninstall)
		do_uninstall
		;;
	update)
		do_update
		;;
	status)
		do_status
		;;
	flavour)
		do_flavour "${2:-}"
		;;
	reencrypt-all)
		do_reencrypt_all
		;;
	add)
		do_add "${2:-}" "${3:-}" "${4:-}"
		;;
	*)
		usage
		exit 1
		;;
	esac

	cleanup
}

main "$@"
