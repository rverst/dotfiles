#!/usr/bin/env zsh
# Switch the active Node.js version for this shell.
#
# Usage:
# `setNode`        - pick from the installed Node versions with fzf.
# `setNode 22`     - switch to Node 22 (major version, or a prefix like 22.23).
# `setNode -q 22`  - switch without printing anything; used to pin a default
#                    from ~/.localrc.
#
# Versions are discovered by ~/.local/scripts/node-bin, which reads the real
# Cellar version behind each keg. Homebrew points every unreleased alias
# (node@23, node@24, ...) at the current unversioned keg, so asking for a
# version that does not exist now fails loudly instead of silently giving you
# a different major.
#
# Puts the selected bin directory at the front of PATH, removing the previously
# selected one first so repeated calls stay idempotent and PATH does not grow.

local quiet=0

while [[ $1 == -* ]]; do
  case $1 in
  -q | --quiet)
    quiet=1
    shift
    ;;
  -h | --help)
    print -u2 'usage: setNode [-q] [<version>]'
    return 0
    ;;
  *)
    print -u2 "setNode: unknown option: $1"
    return 2
    ;;
  esac
done

local version=$1
local listing

if [[ -z $version ]]; then
  listing=$(node-bin --list) || return 1

  local selection
  selection=$(
    print -r -- "$listing" |
      awk -F'\t' '{ printf "%-4s %-12s %s\n", $1, $2, $3 }' |
      fzf --prompt='node> ' --height=40% --reverse \
        --header='select a Node version for this shell'
  )

  [[ -z $selection ]] && return 0
  version=${selection%% *}
fi

local bindir
bindir=$(node-bin "$version") || return 1

# Drop the bin directory we selected last time, if any.
if [[ -n $SETNODE_BIN ]]; then
  path=("${(@)path:#$SETNODE_BIN}")
fi

typeset -g SETNODE_BIN=$bindir
path=("$SETNODE_BIN" $path)

if ((!quiet)); then
  node --version
fi
